<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for Android 12 and newer. -->
<data-extraction-rules>
    <!-- The session never leaves the phone (see backup_rules.xml for why). -->
    <cloud-backup>
        <exclude domain="sharedpref" path="afyaquest_secure_prefs.xml" />
        <exclude domain="sharedpref" path="afyaquest_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="afyaquest_secure_prefs.xml" />
        <exclude domain="sharedpref" path="afyaquest_session.xml" />
    </device-transfer>
</data-extraction-rules>
