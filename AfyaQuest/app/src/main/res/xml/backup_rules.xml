<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 11 and older. -->
<full-backup-content>
    <!-- The session. The encrypted file can only be read with a key that never leaves the phone
         that wrote it, so a restored copy is unreadable; a restored "who is signed in" file would
         claim a session that does not exist. The user simply signs in again and the account's
         progress comes back from the server. -->
    <exclude domain="sharedpref" path="afyaquest_secure_prefs.xml" />
    <exclude domain="sharedpref" path="afyaquest_session.xml" />
</full-backup-content>
